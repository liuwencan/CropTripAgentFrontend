{
  "name": "corp-trip-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:accessibility": "node scripts/check-accessibility.mjs",
    "check:responsive": "node scripts/check-responsive.mjs",
    "check:delivery": "npm run build && node scripts/check-delivery.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.9.11",
    "katex": "^0.16.47",
    "mermaid": "^11.17.2",
    "pinia": "^3.0.3",
    "shiki": "^3.23.0",
    "shiki-stream": "^0.1.4",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "x-markdown-vue": "^0.0.204"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.8"
  }
